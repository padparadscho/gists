root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.json]
indent_size = 2
indent_style = space

[*.{ui,xml,xml.in}]
indent_size = 2
indent_style = space

[*.{vala,vala.in}]
indent_size = 4
indent_style = space
insert_final_newline = true
max_line_length = 100

[meson.build]
indent_size = 2
indent_style = space
