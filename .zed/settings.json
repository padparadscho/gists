{
  "file_types": {
    "Vala": ["*.vala", "*.vala.in", "*.vapi"]
  },
  "languages": {
    "JSON": {
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "format_on_save": "on"
    },
    "JSONC": {
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "format_on_save": "on"
    },
    "XML": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "xmllint",
          "arguments": ["--format", "-"]
        }
      }
    },
    "Meson": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "meson",
          "arguments": [
            "format",
            "--editor-config",
            "--source-file-path",
            "{buffer_path}",
            "-"
          ]
        }
      }
    },
    "Vala": {
      "language_servers": ["vls"],
      "formatter": "language_server",
      "format_on_save": "on"
    }
  }
}
